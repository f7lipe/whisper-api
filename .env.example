# ── OpenAI Whisper ────────────────────────────────────────────────────────────
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=pt

# ── faster-whisper ────────────────────────────────────────────────────────────
FASTER_WHISPER_MODEL=large-v3

# beam_size: 1 (fastest) → 5 (best quality). Default: 5
FASTER_WHISPER_BEAM_SIZE=5

# batch_size > 1 enables BatchedInferencePipeline (~2× faster on CPU)
# Set to 1 to disable (lower latency for very short clips)
FASTER_WHISPER_BATCH_SIZE=8

# Number of CPU threads for CTranslate2 (defaults to os.cpu_count())
# FASTER_WHISPER_CPU_THREADS=8

# Async I/O workers for the model
FASTER_WHISPER_NUM_WORKERS=2

# Strip silence before transcribing (recommended: true)
FASTER_WHISPER_VAD_FILTER=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
